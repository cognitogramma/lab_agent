.env
filesystem-permissions.json
*.polyrmc-backup-*
__pycache__/
*.pyc
.pytest_cache/
.test-tmp*/
.venv/
venv/
*.egg-info/
build/
dist/

# Instrument files and processed output are data, not source.
data/raw/*
!data/raw/.gitkeep
data/runs/*
!data/runs/.gitkeep
# Figures are derived from lab data and this repo is public; regenerate them
# with examples/run_series.py rather than committing results.
data/figures/*
!data/figures/.gitkeep
# Plotting exports are a reshaped copy of data/runs -- same lab data, and the
# full-resolution tables run to ~8 MB each. Regenerate with
# examples/export_for_plotting.py.
data/plotting/*
!data/plotting/.gitkeep
# Agent notes are observations about specific samples and instruments -- lab
# data by the same standard as everything above, and this repo is public.
data/memory/*
!data/memory/.gitkeep
# Saved papers include the experiment context used to find them.
data/literature/
# Session logs carry the whole conversation and every tool output, which is
# lab data by the same standard as everything above. They are also the one
# thing here that is safe to delete: nothing reads them back but a person.
data/logs/*
!data/logs/.gitkeep
# The offline sample session commits for real -- a CSV, a sidecar, a note --
# so it is pointed at its own directory rather than the ones the agent searches
# as memory. Regenerate with examples/sample_session.py.
data/samples/
