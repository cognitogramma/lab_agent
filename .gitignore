.env
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Instrument files and processed output are data, not source.
data/raw/*
!data/raw/.gitkeep
data/runs/*
!data/runs/.gitkeep
# Figures are derived from lab data and this repo is public; regenerate them
# with examples/run_series.py rather than committing results.
data/figures/*
!data/figures/.gitkeep
# Plotting exports are a reshaped copy of data/runs -- same lab data, and the
# full-resolution tables run to ~8 MB each. Regenerate with
# examples/export_for_plotting.py.
data/plotting/*
!data/plotting/.gitkeep
