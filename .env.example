# Copy this file to .env and set the key for whichever provider you use.
#
# You buy your own tokens. This package ships no key and brokers no access --
# the agent is a socket, and you decide which brain plugs into it and who bills
# you for it. Set one of these; the rest can stay blank.
#
# .env is gitignored. Nothing here is ever written into a run sidecar, a figure,
# or a session transcript.

# Gemini -- https://aistudio.google.com/apikey
# Either name works. Google's console labels it GEMINI_API_KEY while the SDK
# reads GOOGLE_API_KEY, so this package accepts both and passes it explicitly.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Claude -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI -- https://platform.openai.com/api-keys
# Note this is an API key, billed per token. A ChatGPT Plus or Pro subscription
# is a different product and does not grant API access.
OPENAI_API_KEY=

# Which provider drives `continuum-spectranalytics agent` when --provider is not passed. Leave
# blank to use whichever one you have keyed.
# CONTINUUM_SPECTRANALYTICS_PROVIDER=gemini

# Model pins. The defaults are pinned so a run can record which brain judged it;
# override here when a pin goes stale or you want a cheaper model.
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5

# Session ceilings, for keeping a runaway loop off your own bill. 0 means none.
# CONTINUUM_SPECTRANALYTICS_BUDGET_REQUESTS=0
# CONTINUUM_SPECTRANALYTICS_BUDGET_TOKENS=0

# Internet tool calls per question, including calls requested in one batch.
# 0 disables the agent's web calls; the manual Research panel is independent.
# CONTINUUM_SPECTRANALYTICS_MAX_WEB_CALLS=8
